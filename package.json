{
  "name": "universal-rate-limiter",
  "version": "1.0.0",
  "description": "A lightweight universal rate limiter for frontend and backend — works in Browser, Node.js, Express, Next.js Middleware, and React.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "keywords": [
    "rate limiter",
    "ratelimit",
    "nextjs",
    "express",
    "typescript",
    "frontend",
    "backend",
    "middleware",
    "browser",
    "serverless"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/universal-rate-limiter.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --watch",
    "prepublishOnly": "npm run build",
    "test:express": "npm run build && node examples/express/server.js",
    "test:vanilla": "npm run build && echo 'Open examples/vanilla/index.html in your browser'"
  },
  "devDependencies": {
    "@types/react": "^19.2.6",
    "express": "^5.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
