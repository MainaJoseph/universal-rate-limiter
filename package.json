{
  "name": "universal-rate-limiter",
  "version": "1.0.2",
  "description": "A lightweight universal rate limiter for frontend and backend — works in Browser, Node.js, Bun, Express, Next.js Middleware, and React.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "keywords": [
    "rate limiter",
    "ratelimit",
    "nextjs",
    "express",
    "bun",
    "typescript",
    "frontend",
    "backend",
    "middleware",
    "browser",
    "serverless",
    "edge",
    "react",
    "rate-limiting",
    "api",
    "throttle"
  ],
  "author": "Joseph Maina <mainajm254@gmail.com> (https://github.com/MainaJoseph)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MainaJoseph/universal-rate-limiter.git"
  },
  "bugs": {
    "url": "https://github.com/MainaJoseph/universal-rate-limiter/issues"
  },
  "homepage": "https://github.com/MainaJoseph/universal-rate-limiter#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test:express": "npm run build && node examples/express/server.js",
    "test:vanilla": "npm run build && echo 'Open examples/vanilla/index.html in your browser'",
    "ci:check-build": "node scripts/check-build.js",
    "ci:check-size": "node scripts/check-size.js"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.6",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
